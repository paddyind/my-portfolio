# Keep it minimal - only exclude what we don't need

# Node modules (not needed since we use pre-built dist/)
node_modules/

# Git and version control
.git/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment files
.env*

# Note: Keep package*.json, vite.config.js, tailwind, and postcss for Docker frontend builds

# Documentation
README.md
*.md

# Kubernetes and scripts
k8s/
helm/
scripts/