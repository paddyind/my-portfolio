# Docker Compose — published host ports (defaults avoid clashes with other apps).
# See ../observability-platform/docs/ARCHITECTURE.md
PORTFOLIO_HOST_FRONTEND_PORT=3400
PORTFOLIO_HOST_SERVER_PORT=3401
PORTFOLIO_HOST_OLLAMA_PORT=3420

# Optional: when running the ollama service in compose, point the server at the container:
# OLLAMA_HOST=http://ollama:11434
