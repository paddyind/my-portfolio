# Docker Compose — published host ports (defaults avoid clashes with other apps).
PORTFOLIO_HOST_FRONTEND_PORT=3400
PORTFOLIO_HOST_SERVER_PORT=3401
PORTFOLIO_HOST_OLLAMA_PORT=3420

# Optional API base URL override (leave unset for npm run dev and Docker Compose)
# VITE_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Private LLM (Ollama container) — all inference stays on your machine
# ---------------------------------------------------------------------------
# 1. docker compose --profile llm up -d
# 2. ./scripts/ollama-setup.sh medium
# 3. Set LLM_ENABLED=true and restart portfolio-server

LLM_ENABLED=false
LLM_MODEL=gemma2:2b

# Ollama API URL (portfolio-server → ollama container on Docker network)
OLLAMA_HOST=http://ollama:11434

# Model pull profile for ./scripts/ollama-setup.sh: light | medium | heavy
MODEL_PROFILE=medium

# Keep model loaded in GPU/RAM (reduces cold-start latency)
OLLAMA_KEEP_ALIVE=30m

# Local dev without compose profile: Ollama on host
# OLLAMA_HOST=http://host.docker.internal:11434
# Or map container port: OLLAMA_HOST=http://host.docker.internal:3420
